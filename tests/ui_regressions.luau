check("Original Crispy window size, title and RightShift binding are restored",function()
    local spec=Runtime.Window.spec
    assert(spec.Title=="SwaX" and spec.Size.X.Offset==820 and spec.Size.Y.Offset==545)
    assert(spec.Keybind==Enum.KeyCode.RightShift and spec.DragStyle==1 and spec.ShowUserInfo)
    assert(spec.ConfigName=="SwaXCore" and spec.AutoLoad==false)
end)
check("Only Aimbot, FOV, ESP and Config tabs are kept",function()
    local expected={"Aimbot","FOV","ESP","Config"}
    assert(#Runtime.Window._tabs==#expected)
    for index,name in ipairs(expected) do assert(Runtime.Window._tabs[index].spec.Name==name) end
    for _,flag in ipairs({"a_sil","a_trig","m_autoheal","m_spd","m_mednocd","e_loadout"}) do
        assert(not mockCrispy.controls[flag],flag)
    end
end)
check("Loading screen finishes and profiles use the original library UI",function()
    assert(mockCrispy.loaders[1].finished and mockCrispy.loaders[1].destroyed)
    assert(Runtime.Loader==nil and mockCrispy.profileTab==Runtime.Window._tabs[4])
    assert(mockCrispy.loadCalls==1 and mockCrispy.Config._autoSaveToken.period==30)
end)
check("Core settings and Crispy controls synchronize in both directions",function()
    mockCrispy.controls.a_fov:Set(440);assert(ConfigService.Get("FOV")==440)
    ConfigService.Set("FOV",275);assert(mockCrispy.controls.a_fov:Get()==275)
    mockCrispy.controls.a_aimmode:Set("Mouse");assert(ConfigService.Get("AimMode")=="Mouse")
    ConfigService.Set("AimMode","Camera");assert(mockCrispy.controls.a_aimmode:Get()=="Camera")
    local color=Color3.fromRGB(20,200,80)
    mockCrispy.controls.ui_accent:Set(color)
    assert(ConfigService.Get("Accent")==color and Runtime.Window.accent==color and VisualDebug.GetFOVCircle().Color==color)
end)
check("ClosestPart dropdown remains synchronized with its two core settings",function()
    mockCrispy.controls.a_part:Set("ClosestPart");assert(ConfigService.Get("ClosestPart"))
    mockCrispy.controls.a_part:Set("UpperTorso")
    assert(not ConfigService.Get("ClosestPart") and ConfigService.Get("TargetPart")=="UpperTorso")
    ConfigService.Set("ClosestPart",true);assert(mockCrispy.controls.a_part:Get()=="ClosestPart")
    ConfigService.Set("ClosestPart",false);ConfigService.Set("TargetPart","Head")
    assert(mockCrispy.controls.a_part:Get()=="Head")
end)
check("Projectile toggle and speed actually update the ballistic core",function()
    mockCrispy.controls.a_bspd:Set(900);assert(ConfigService.Get("BallisticSpeed")==0)
    mockCrispy.controls.a_balena:Set(true);assert(ConfigService.Get("BallisticSpeed")==900)
    mockCrispy.controls.a_bspd:Set(1200);assert(ConfigService.Get("BallisticSpeed")==1200)
    mockCrispy.controls.a_balena:Set(false);assert(ConfigService.Get("BallisticSpeed")==0)
    assert(mockCrispy.controls.a_bspd:Get()==1200)
    ConfigService.Set("BallisticSpeed",8000)
    assert(mockCrispy.controls.a_balena:Get() and mockCrispy.controls.a_bspd:Get()==8000)
    ConfigService.Set("BallisticSpeed",0)
end)
check("OnApplied restores disabled callbacks, false flags and projectile composites",function()
    local load,profile=mockCrispy.Config.Load,mockCrispy.Config.SetProfile
    mockCrispy.Config.Apply({a_en=false,a_plr=false,a_npc=true,a_fov=333,a_part="ClosestPart",
        a_balena=true,a_bspd=1700,a_aimmode="Mouse",a_drop=true},{Callbacks=false})
    flush()
    assert(not ConfigService.Get("Enabled") and not ConfigService.Get("LockOnPlayers") and ConfigService.Get("LockOnNPCs"))
    assert(ConfigService.Get("FOV")==333 and ConfigService.Get("ClosestPart"))
    assert(ConfigService.Get("BallisticSpeed")==1700 and ConfigService.Get("DropCompensation"))
    assert(ConfigService.Get("AimMode")=="Mouse")
    assert(mockCrispy.Config.Load==load and mockCrispy.Config.SetProfile==profile,"Config methods were monkeypatched")
    mockCrispy.Config.Apply({a_part="Torso",a_balena=false,a_bspd=850},{Callbacks=false});flush()
    assert(not ConfigService.Get("ClosestPart") and ConfigService.Get("TargetPart")=="Torso")
    assert(ConfigService.Get("BallisticSpeed")==0 and mockCrispy.controls.a_bspd:Get()==850)
end)
check("Config Save and Load buttons reapply the profile to the core",function()
    local buttons=Runtime.Window._tabs[4].buttons
    mockCrispy.controls.a_fov:Set(242);buttons.Save()
    mockCrispy.controls.a_fov:Set(600);buttons.Load();flush()
    assert(ConfigService.Get("FOV")==242)
    buttons["Reset Core Settings"]()
    for key,value in pairs(ConfigService.Defaults) do assert(ConfigService.Get(key)==value,key) end
end)
check("Original RightShift window binding toggles the GUI",function()
    local input=game:GetService("UserInputService")
    input.InputBegan:Fire({KeyCode=Enum.KeyCode.RightShift},false);assert(not Runtime.GUI.Enabled)
    input.InputBegan:Fire({KeyCode=Enum.KeyCode.RightShift},false);assert(Runtime.GUI.Enabled)
end)
check("Projectile UI leads farther with distance and less with higher speed",function()
    local rig=Instance.new("Model");rig.Parent=workspace
    local head=Instance.new("Part");head.Name="Head";head.Position=Vector3.new(0,0,-300);head.Parent=rig
    local root=Instance.new("Part");root.Name="HumanoidRootPart";root.Position=Vector3.new(0,-3,-300)
    root.AssemblyLinearVelocity=Vector3.new(30,0,0);root.Parent=rig;rig.PrimaryPart=root
    local frame=Camera.CFrame;Camera.CFrame=CFrame.new()
    mockCrispy.controls.a_pred:Set(0);mockCrispy.controls.a_drop:Set(false)
    mockCrispy.controls.a_bspd:Set(150);mockCrispy.controls.a_balena:Set(true)
    local first=TargetSelector.PredictPos(rig)
    vectorNear(first,Vector3.new(30*300/math.sqrt(150^2-30^2),0,-300),1e-5)
    head.Position=Vector3.new(0,0,-600)
    local far=TargetSelector.PredictPos(rig);near(far.X,first.X*2,1e-5)
    head.Position=Vector3.new(0,0,-300);mockCrispy.controls.a_bspd:Set(300)
    local fast=TargetSelector.PredictPos(rig);assert(fast.X<first.X)
    mockCrispy.controls.a_balena:Set(false);vectorNear(TargetSelector.PredictPos(rig),head.Position)
    Camera.CFrame=frame;rig:Destroy();Runtime.Window._tabs[4].buttons["Reset Core Settings"]()
end)
check("Projectile UI drop toggle adds the required upward compensation",function()
    local rig=Instance.new("Model");rig.Parent=workspace
    local head=Instance.new("Part");head.Name="Head";head.Position=Vector3.new(100,0,0);head.Parent=rig
    head.AssemblyLinearVelocity=Vector3.zero
    local gravity,frame=workspace.Gravity,Camera.CFrame;workspace.Gravity=20;Camera.CFrame=CFrame.new()
    mockCrispy.controls.a_pred:Set(0);mockCrispy.controls.a_bspd:Set(100);mockCrispy.controls.a_balena:Set(true)
    mockCrispy.controls.a_drop:Set(false);near(TargetSelector.PredictPos(rig).Y,0)
    mockCrispy.controls.a_drop:Set(true)
    local t=CoreMath.InterceptTime(head.Position,Vector3.zero,100,Vector3.new(0,-20,0))
    near(TargetSelector.PredictPos(rig).Y,10*t*t,1e-5)
    head.Position=Vector3.new(501,0,0);assert(TargetSelector.PredictPos(rig)==nil)
    workspace.Gravity=gravity;Camera.CFrame=frame;rig:Destroy()
    Runtime.Window._tabs[4].buttons["Reset Core Settings"]()
end)
